{
  "$description": "Fuente unica de tokens del ERP. Editar aqui y ejecutar `node scripts/build-tokens.mjs`. No editar tokens.css a mano.",
  "color": {
    "primary": {
      "value": "#2563EB",
      "use": "Acciones principales, enlaces, seleccion, foco"
    },
    "primary-hover": {
      "value": "#1D4ED8",
      "use": "Hover/pressed de primary (propuesto)"
    },
    "primary-subtle": {
      "value": "#EFF4FF",
      "use": "Fila seleccionada, fondo de foco suave (propuesto)"
    },
    "sidebar": {
      "value": "#1E3A8A",
      "use": "Fondo de la barra lateral (240 px)"
    },
    "sidebar-text": {
      "value": "#FFFFFF",
      "use": "Texto/iconos activos en sidebar (propuesto)"
    },
    "sidebar-text-muted": {
      "value": "#B4C5FF",
      "use": "Texto/iconos inactivos en sidebar (propuesto)"
    },
    "background": {
      "value": "#F5F7FA",
      "use": "Fondo general de la aplicacion"
    },
    "surface": {
      "value": "#FFFFFF",
      "use": "Tarjetas, tablas, paneles, modales"
    },
    "border": {
      "value": "#E5E7EB",
      "use": "Separadores, bordes de tarjeta y tabla (decorativo)"
    },
    "border-input": {
      "value": "#8A919E",
      "use": "Contorno de inputs, checkbox, radio (>=3:1, WCAG 1.4.11) (propuesto)"
    },
    "text-primary": {
      "value": "#111827",
      "use": "Titulos, valores numericos, texto de tabla"
    },
    "text-secondary": {
      "value": "#6B7280",
      "use": "Etiquetas, encabezados, metadatos, importes en Bs"
    },
    "success": {
      "value": "#16A34A",
      "use": "Relleno/icono/borde de exito. NUNCA texto pequeno"
    },
    "success-text": {
      "value": "#15803D",
      "use": "Texto de exito sobre surface (propuesto)"
    },
    "success-bg": {
      "value": "#DCFCE7",
      "use": "Fondo de insignia de exito (propuesto)"
    },
    "warning": {
      "value": "#F59E0B",
      "use": "Relleno/icono de advertencia. NUNCA texto sobre blanco"
    },
    "warning-text": {
      "value": "#B45309",
      "use": "Texto de advertencia sobre surface (propuesto)"
    },
    "warning-bg": {
      "value": "#FEF3C7",
      "use": "Fondo de insignia de advertencia (propuesto)"
    },
    "error": {
      "value": "#DC2626",
      "use": "Error, vencido, sin stock, accion destructiva"
    },
    "error-text": {
      "value": "#B91C1C",
      "use": "Texto de error sobre fondos tintados (propuesto)"
    },
    "error-bg": {
      "value": "#FEE2E2",
      "use": "Fondo de insignia de error (propuesto)"
    },
    "info": {
      "value": "#0EA5E9",
      "use": "Relleno/icono informativo. NUNCA texto"
    },
    "info-text": {
      "value": "#0369A1",
      "use": "Texto informativo sobre surface (propuesto)"
    },
    "info-bg": {
      "value": "#E0F2FE",
      "use": "Fondo de insignia informativa (propuesto)"
    },
    "whatsapp": {
      "value": "#25D366",
      "use": "EXCLUSIVO de lo que ocurre por WhatsApp (icono, etiqueta de canal)"
    },
    "whatsapp-bg": {
      "value": "#E8FBEF",
      "use": "Fondo de insignia de canal WhatsApp (propuesto)"
    },
    "chart-1": {
      "value": "#2A78D6",
      "use": "Serie 1 de graficas (validada con dataviz, all-pairs)"
    },
    "chart-2": {
      "value": "#E87BA4",
      "use": "Serie 2. Contraste <3:1: exige etiquetas directas o vista de tabla"
    },
    "chart-3": {
      "value": "#4A3AA7",
      "use": "Serie 3. Maximo 3 series; el resto se agrupa en 'Otros' o se divide en graficas pequenas"
    },
    "chart-other": {
      "value": "#6B7280",
      "use": "'Otros' (series agrupadas)"
    },
    "text-secondary-strong": {
      "value": "#4B5563",
      "use": "Texto secundario sobre fondos tintados (fila seleccionada/hover, primary-subtle). text-secondary (#6B7280) no llega a 4.5:1 ahi (propuesto)"
    }
  },
  "font": {
    "family": {
      "value": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "headline-sm": {
      "size": "1.25rem",
      "weight": "600",
      "line": "1.75rem"
    },
    "body-md": {
      "size": "0.875rem",
      "weight": "400",
      "line": "1.25rem"
    },
    "table-num": {
      "size": "0.875rem",
      "weight": "600",
      "line": "1.25rem",
      "tracking": "0.01em"
    },
    "label-xs": {
      "size": "0.75rem",
      "weight": "500",
      "line": "1rem"
    }
  },
  "radius": {
    "badge": "4px",
    "control": "6px",
    "card": "10px",
    "pill": "9999px"
  },
  "space": {
    "sidebar-width": "240px",
    "table-row-height": "40px",
    "container-max": "1440px",
    "gutter": "1rem"
  },
  "elevation": {
    "none": "none",
    "overlay": "0 8px 24px rgba(17, 24, 39, 0.12)"
  },
  "contrast": [
    {
      "fg": "text-primary",
      "bg": "background",
      "min": 4.5
    },
    {
      "fg": "text-primary",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "text-secondary",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "text-secondary",
      "bg": "background",
      "min": 4.5,
      "note": "Pasa justo en el limite (4.50): para texto de 12 px preferir surface"
    },
    {
      "fg": "surface",
      "bg": "primary",
      "min": 4.5
    },
    {
      "fg": "surface",
      "bg": "primary-hover",
      "min": 4.5
    },
    {
      "fg": "primary",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "primary",
      "bg": "background",
      "min": 4.5
    },
    {
      "fg": "sidebar-text",
      "bg": "sidebar",
      "min": 4.5
    },
    {
      "fg": "sidebar-text-muted",
      "bg": "sidebar",
      "min": 4.5
    },
    {
      "fg": "success-text",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "success-text",
      "bg": "success-bg",
      "min": 4.5
    },
    {
      "fg": "warning-text",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "warning-text",
      "bg": "warning-bg",
      "min": 4.5
    },
    {
      "fg": "error",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "error-text",
      "bg": "error-bg",
      "min": 4.5
    },
    {
      "fg": "info-text",
      "bg": "surface",
      "min": 4.5
    },
    {
      "fg": "info-text",
      "bg": "info-bg",
      "min": 4.5
    },
    {
      "fg": "text-primary",
      "bg": "whatsapp-bg",
      "min": 4.5
    },
    {
      "fg": "surface",
      "bg": "error",
      "min": 4.5
    },
    {
      "fg": "border-input",
      "bg": "surface",
      "min": 3.0,
      "note": "Componente de UI (WCAG 1.4.11)"
    },
    {
      "fg": "success",
      "bg": "surface",
      "min": 3.0,
      "note": "Solo icono/relleno"
    },
    {
      "fg": "whatsapp",
      "bg": "surface",
      "min": 1.0,
      "note": "Solo decorativo + siempre con etiqueta de texto"
    },
    {
      "fg": "chart-1",
      "bg": "surface",
      "min": 3.0,
      "note": "Marca grafica"
    },
    {
      "fg": "chart-3",
      "bg": "surface",
      "min": 3.0,
      "note": "Marca grafica"
    },
    {
      "fg": "chart-2",
      "bg": "surface",
      "min": 2.5,
      "note": "Falla 3:1 (2.62): relief rule, etiquetas directas o tabla obligatorias"
    },
    {
      "fg": "chart-other",
      "bg": "surface",
      "min": 3.0,
      "note": "Marca grafica"
    },
    {
      "fg": "surface",
      "bg": "text-secondary",
      "min": 4.5,
      "note": "Icono sobre marcador 'sin senal'"
    },
    {
      "fg": "text-primary",
      "bg": "warning",
      "min": 4.5,
      "note": "Icono sobre marcador 'detenido' (blanco no pasa)"
    },
    {
      "fg": "surface",
      "bg": "success",
      "min": 3.0,
      "note": "Icono grande sobre marcador 'entregado'"
    },
    {
      "fg": "text-primary",
      "bg": "primary-subtle",
      "min": 4.5
    },
    {
      "fg": "text-secondary-strong",
      "bg": "primary-subtle",
      "min": 4.5
    },
    {
      "fg": "text-secondary-strong",
      "bg": "background",
      "min": 4.5
    },
    {
      "fg": "text-secondary",
      "bg": "primary-subtle",
      "min": 4.0,
      "note": "NO usar: por eso existe text-secondary-strong en superficies tintadas"
    }
  ],
  "alias": {
    "map-route-active": "primary",
    "map-route-done": "text-secondary",
    "map-route-planned": "border-input",
    "map-vehicle-moving": "primary",
    "map-vehicle-stopped": "warning",
    "map-vehicle-offline": "text-secondary",
    "map-vehicle-delivered": "success",
    "map-vehicle-incident": "error",
    "map-stop-pending": "surface",
    "focus-ring": "primary",
    "pos-total-bg": "sidebar"
  },
  "space-scale": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "size": {
    "control-sm": "28px",
    "control-md": "36px",
    "control-lg": "44px",
    "touch": "48px",
    "icon-sm": "16px",
    "icon-md": "20px",
    "icon-lg": "24px",
    "header-height": "56px",
    "sidebar-collapsed": "64px",
    "drawer-width": "440px",
    "modal-sm": "400px",
    "modal-md": "560px",
    "modal-lg": "800px",
    "map-panel-width": "360px",
    "pos-keypad-key": "64px"
  },
  "density": {
    "compact": {
      "row": "40px",
      "control": "36px"
    },
    "comfortable": {
      "row": "48px",
      "control": "40px"
    }
  },
  "z": {
    "dropdown": "1000",
    "sticky": "1100",
    "drawer": "1200",
    "modal": "1300",
    "toast": "1400",
    "tooltip": "1500"
  },
  "motion": {
    "fast": "100ms",
    "base": "160ms",
    "slow": "240ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "theming": {
    "$description": "Que puede cambiar el panel de configuracion y que no. Ver theme/theme.js",
    "configurable": [
      "primary",
      "sidebar",
      "logo",
      "brandName",
      "density"
    ],
    "derived": [
      "primary-hover",
      "primary-subtle",
      "sidebar-text",
      "sidebar-text-muted",
      "focus-ring",
      "map-*"
    ],
    "locked": [
      "semanticos (success/warning/error/info y sus -text/-bg)",
      "whatsapp",
      "tipografia",
      "radios",
      "chart-*"
    ]
  }
}