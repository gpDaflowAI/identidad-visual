{
  "$description": "Fuente unica de tokens del ERP. Editar aqui y ejecutar `node scripts/build-tokens.mjs`. No editar tokens.css a mano.",
  "color": {
    "primary":            { "value": "#2563EB", "use": "Acciones principales, enlaces, seleccion, foco" },
    "primary-hover":      { "value": "#1D4ED8", "use": "Hover/pressed de primary (propuesto)" },
    "primary-subtle":     { "value": "#EFF4FF", "use": "Fila seleccionada, fondo de foco suave (propuesto)" },
    "sidebar":            { "value": "#1E3A8A", "use": "Fondo de la barra lateral (240 px)" },
    "sidebar-text":       { "value": "#FFFFFF", "use": "Texto/iconos activos en sidebar (propuesto)" },
    "sidebar-text-muted": { "value": "#B4C5FF", "use": "Texto/iconos inactivos en sidebar (propuesto)" },

    "background":         { "value": "#F5F7FA", "use": "Fondo general de la aplicacion" },
    "surface":            { "value": "#FFFFFF", "use": "Tarjetas, tablas, paneles, modales" },
    "border":             { "value": "#E5E7EB", "use": "Separadores, bordes de tarjeta y tabla (decorativo)" },
    "border-input":       { "value": "#8A919E", "use": "Contorno de inputs, checkbox, radio (>=3:1, WCAG 1.4.11) (propuesto)" },
    "text-primary":       { "value": "#111827", "use": "Titulos, valores numericos, texto de tabla" },
    "text-secondary":     { "value": "#6B7280", "use": "Etiquetas, encabezados, metadatos, importes en Bs" },

    "success":            { "value": "#16A34A", "use": "Relleno/icono/borde de exito. NUNCA texto pequeno" },
    "success-text":       { "value": "#15803D", "use": "Texto de exito sobre surface (propuesto)" },
    "success-bg":         { "value": "#DCFCE7", "use": "Fondo de insignia de exito (propuesto)" },
    "warning":            { "value": "#F59E0B", "use": "Relleno/icono de advertencia. NUNCA texto sobre blanco" },
    "warning-text":       { "value": "#B45309", "use": "Texto de advertencia sobre surface (propuesto)" },
    "warning-bg":         { "value": "#FEF3C7", "use": "Fondo de insignia de advertencia (propuesto)" },
    "error":              { "value": "#DC2626", "use": "Error, vencido, sin stock, accion destructiva" },
    "error-text":         { "value": "#B91C1C", "use": "Texto de error sobre fondos tintados (propuesto)" },
    "error-bg":           { "value": "#FEE2E2", "use": "Fondo de insignia de error (propuesto)" },
    "info":               { "value": "#0EA5E9", "use": "Relleno/icono informativo. NUNCA texto" },
    "info-text":          { "value": "#0369A1", "use": "Texto informativo sobre surface (propuesto)" },
    "info-bg":            { "value": "#E0F2FE", "use": "Fondo de insignia informativa (propuesto)" },

    "whatsapp":           { "value": "#25D366", "use": "EXCLUSIVO de lo que ocurre por WhatsApp (icono, etiqueta de canal)" },
    "whatsapp-bg":        { "value": "#E8FBEF", "use": "Fondo de insignia de canal WhatsApp (propuesto)" }
  },
  "font": {
    "family": { "value": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "headline-sm": { "size": "1.25rem",  "weight": "600", "line": "1.75rem" },
    "body-md":     { "size": "0.875rem", "weight": "400", "line": "1.25rem" },
    "table-num":   { "size": "0.875rem", "weight": "600", "line": "1.25rem", "tracking": "0.01em" },
    "label-xs":    { "size": "0.75rem",  "weight": "500", "line": "1rem" }
  },
  "radius": {
    "badge": "4px",
    "control": "6px",
    "card": "10px",
    "pill": "9999px"
  },
  "space": {
    "sidebar-width": "240px",
    "table-row-height": "40px",
    "container-max": "1440px",
    "gutter": "1rem"
  },
  "elevation": {
    "none": "none",
    "overlay": "0 8px 24px rgba(17, 24, 39, 0.12)"
  },
  "contrast": [
    { "fg": "text-primary",   "bg": "background", "min": 4.5 },
    { "fg": "text-primary",   "bg": "surface",    "min": 4.5 },
    { "fg": "text-secondary", "bg": "surface",    "min": 4.5 },
    { "fg": "text-secondary", "bg": "background", "min": 4.5, "note": "Pasa justo en el limite (4.50): para texto de 12 px preferir surface" },
    { "fg": "surface",        "bg": "primary",    "min": 4.5 },
    { "fg": "surface",        "bg": "primary-hover", "min": 4.5 },
    { "fg": "primary",        "bg": "surface",    "min": 4.5 },
    { "fg": "primary",        "bg": "background", "min": 4.5 },
    { "fg": "sidebar-text",   "bg": "sidebar",    "min": 4.5 },
    { "fg": "sidebar-text-muted", "bg": "sidebar", "min": 4.5 },
    { "fg": "success-text",   "bg": "surface",    "min": 4.5 },
    { "fg": "success-text",   "bg": "success-bg", "min": 4.5 },
    { "fg": "warning-text",   "bg": "surface",    "min": 4.5 },
    { "fg": "warning-text",   "bg": "warning-bg", "min": 4.5 },
    { "fg": "error",          "bg": "surface",    "min": 4.5 },
    { "fg": "error-text",     "bg": "error-bg",   "min": 4.5 },
    { "fg": "info-text",      "bg": "surface",    "min": 4.5 },
    { "fg": "info-text",      "bg": "info-bg",    "min": 4.5 },
    { "fg": "text-primary",   "bg": "whatsapp-bg","min": 4.5 },
    { "fg": "surface",        "bg": "error",      "min": 4.5 },
    { "fg": "border-input",   "bg": "surface",    "min": 3.0, "note": "Componente de UI (WCAG 1.4.11)" },
    { "fg": "success",        "bg": "surface",    "min": 3.0, "note": "Solo icono/relleno" },
    { "fg": "whatsapp",       "bg": "surface",    "min": 1.0, "note": "Solo decorativo + siempre con etiqueta de texto" }
  ]
}
